// Prisma Schema for SchoolConnect - Student Social Interaction Platform
// Target Database: PostgreSQL (Production / Render)

generator client {
  provider = "prisma-client-js"
}

generator serverClient {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum NoticeCategory {
  CIRCULAR
  EXAM_SCHEDULE
  EVENT
  HOLIDAY_NOTICE
}

enum NoticePriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ClubRole {
  MEMBER
  MODERATOR
  LEADER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  PENDING
  GRADED
  LATE
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  password              String
  role                  Role                @default(STUDENT)
  isVerified            Boolean             @default(false)
  verificationToken     String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  isBlocked             Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Profile
  profile               Profile?

  // Social Feed Relations
  posts                 Post[]              @relation("UserPosts")
  comments              Comment[]
  likes                 Like[]

  // Friend System Relations
  sentFriendRequests    FriendRequest[]     @relation("SentRequests")
  receivedFriendRequests FriendRequest[]    @relation("ReceivedRequests")
  friendshipsInitiated  Friendship[]        @relation("UserAFriends")
  friendshipsReceived   Friendship[]        @relation("UserBFriends")

  // Clubs Relations
  clubMemberships       ClubMember[]
  ledClubs              Club[]              @relation("ClubLeader")
  clubDiscussions       ClubDiscussion[]

  // Polls Relations
  createdPolls          Poll[]
  votes                 Vote[]

  // Messaging Relations
  sentMessages          Message[]           @relation("SentMessages")
  receivedMessages      Message[]           @relation("ReceivedMessages")

  // Notices / Announcements
  announcements         Announcement[]

  // Moderation / Reports
  reportsSubmitted      Report[]            @relation("Reporter")

  // Academic Suite: Quizzes, Assignments & Notes
  quizzesCreated        Quiz[]              @relation("QuizCreator")
  quizSubmissions       QuizSubmission[]
  assignmentsCreated    Assignment[]        @relation("AssignmentCreator")
  assignmentSubmissions AssignmentSubmission[]
  notesAuthored         StudyNote[]         @relation("NoteAuthor")
  noteHelpfulVotes      NoteHelpfulVote[]

  @@index([email])
  @@index([role])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  avatarUrl   String?
  grade       String?  // e.g. "Grade 10"
  section     String?  // e.g. "Section A"
  bio         String?
  interests   String?  // Comma-separated or JSON
  phone       String?
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  imageUrl    String?
  clubId      String?
  club        Club?     @relation(fields: [clubId], references: [id], onDelete: SetNull)
  hashtags    String?   // comma-separated tags e.g. "#science,#project"
  isModerated Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    Comment[]
  likes       Like[]

  @@index([authorId])
  @@index([createdAt])
  @@index([clubId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model FriendRequest {
  id          String              @id @default(cuid())
  senderId    String
  sender      User                @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("UserAFriends", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("UserBFriends", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Club {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String
  category    String           // e.g. "Academics", "Technology", "Environment", "Sports", "Arts"
  bannerUrl   String?
  iconUrl     String?
  leaderId    String?
  leader      User?            @relation("ClubLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members     ClubMember[]
  posts       Post[]
  events      ClubEvent[]
  discussions ClubDiscussion[]
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model ClubEvent {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  description String
  eventDate   DateTime
  location    String
  createdAt   DateTime @default(now())

  @@index([clubId])
}

model ClubDiscussion {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([authorId])
}

model Poll {
  id        String       @id @default(cuid())
  creatorId String
  creator   User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  question  String
  expiresAt DateTime?
  isClosed  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  options   PollOption[]
  votes     Vote[]

  @@index([creatorId])
}

model PollOption {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId])
}

model Announcement {
  id            String         @id @default(cuid())
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  content       String
  category      NoticeCategory @default(CIRCULAR)
  priority      NoticePriority @default(NORMAL)
  attachmentUrl String?
  targetGrade   String?        @default("ALL")
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([category])
  @@index([priority])
  @@index([createdAt])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String       // "POST", "USER", "COMMENT"
  targetId    String
  reason      String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([reporterId])
}

// ==========================================
// 1. QUIZZES & COMPETITIONS (UNTIMED)
// ==========================================
model Quiz {
  id                String           @id @default(cuid())
  creatorId         String
  creator           User             @relation("QuizCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  title             String
  description       String
  subject           String           // e.g. "Science", "Mathematics", "Coding", "English"
  grade             String           // e.g. "Grade 9", "All Grades"
  totalPoints       Int              @default(100)
  status            QuizStatus       @default(PUBLISHED)
  startDate         DateTime         // Competition start timestamp
  endDate           DateTime         // Competition conclusion timestamp
  isResultsReleased Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  questions         QuizQuestion[]
  submissions       QuizSubmission[]

  @@index([creatorId])
  @@index([subject])
  @@index([grade])
  @@index([startDate, endDate])
}

model QuizQuestion {
  id           String       @id @default(cuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String
  options      String[]     // MCQ options array
  correctIndex Int          // Index of correct option (0, 1, 2, 3)
  points       Int          @default(10)
  order        Int          @default(0)

  answers      QuizAnswer[]

  @@index([quizId])
}

model QuizSubmission {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Int          @default(0)
  maxScore    Int          @default(0)
  completedAt DateTime     @default(now())

  answers     QuizAnswer[]

  @@unique([quizId, studentId])
  @@index([quizId, score, completedAt])
  @@index([studentId])
}

model QuizAnswer {
  id            String         @id @default(cuid())
  submissionId  String
  submission    QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId    String
  question      QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int
  isCorrect     Boolean
  pointsAwarded Int            @default(0)

  @@index([submissionId])
}

// ==========================================
// 2. ASSIGNMENTS & HOMEWORK PORTAL
// ==========================================
model Assignment {
  id            String                 @id @default(cuid())
  creatorId     String
  creator       User                   @relation("AssignmentCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  title         String
  description   String
  subject       String
  grade         String
  dueDate       DateTime
  maxPoints     Int                    @default(100)
  attachmentUrl String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  submissions   AssignmentSubmission[]

  @@index([creatorId])
  @@index([subject])
  @@index([grade])
  @@index([dueDate])
}

model AssignmentSubmission {
  id            String           @id @default(cuid())
  assignmentId  String
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content       String
  attachmentUrl String?
  status        SubmissionStatus @default(PENDING)
  grade         Int?
  feedback      String?
  submittedAt   DateTime         @default(now())
  gradedAt      DateTime?

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

// ==========================================
// 3. STUDY NOTES & LEARNING REPOSITORY
// ==========================================
model StudyNote {
  id           String            @id @default(cuid())
  authorId     String
  author       User              @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title        String
  description  String
  subject      String
  grade        String
  chapter      String?
  fileUrl      String
  fileType     String            // "PDF", "DOCX", "LINK"
  helpfulCount Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  helpfulVotes NoteHelpfulVote[]

  @@index([subject])
  @@index([grade])
  @@index([authorId])
}

model NoteHelpfulVote {
  id        String    @id @default(cuid())
  noteId    String
  note      StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([noteId, userId])
}
