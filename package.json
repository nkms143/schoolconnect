{
  "name": "schoolconnect-workspace",
  "version": "1.0.0",
  "description": "SchoolConnect - Student Social Interaction Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "db:generate": "npm --prefix server run db:generate",
    "db:push": "npm --prefix server run db:push",
    "db:seed": "npm --prefix server run db:seed",
    "start": "npm --prefix server start"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "school",
    "social-network",
    "react",
    "nodejs",
    "express",
    "prisma",
    "postgresql",
    "socket.io",
    "tailwind"
  ],
  "author": "SchoolConnect Team",
  "license": "MIT"
}
