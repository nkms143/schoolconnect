# SchoolConnect Server Environment Variables

PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL for Production / Render)
# Example for local SQLite: file:./dev.db (if using SQLite schema)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolconnect?schema=public"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_schoolconnect_safe_school_2026_change_in_prod
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Storage (if configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
